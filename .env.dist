POSTGRES_USER=root
POSTGRES_PASSWORD=12345
POSTGRES_DB=learnic
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

FASTAPI_DEBUG=0
SQLALCHEMY_DEBUG=0
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=learnic
S3_SECRET_KEY=learnic_secret
S3_BUCKET=learnic
S3_REGION=us-east-1

# TaskIQ broker + result backend (Redis).
# The deploy ships a BUNDLED Redis by default (docker-compose.redis.yaml, toggled
# by REDIS below), reachable by its compose service name — hence `redis:6379`.
#   - LOCAL `just dev`: the worker runs on the host against the docker-compose.dev
#     Redis (published on :6379), so there use redis://localhost:6379 instead.
#   - EXTERNAL/managed Redis: set REDIS=external and point these at it.
TASKIQ_BROKER_URL=redis://redis:6379/0
TASKIQ_RESULT_BACKEND_URL=redis://redis:6379/1
TASKIQ_IN_MEMORY=false
TASKIQ_WORKERS=2

# Bundled-Redis toggle for `just prod-up` / `prod-up-colocated`:
#   unset / bundled — start the in-stack Redis from docker-compose.redis.yaml (default)
#   external        — don't start a Redis container; use the URLs above as-is
# REDIS=external

# Reserved; not currently read by the app.
REDIS_URL=redis://redis:6379/2

RUSENDER_API_KEY=
RUSENDER_FROM_EMAIL=noreply@learnic.ru
RUSENDER_FROM_NAME=Learnic

AUTH_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_SIGNUP_SESSION_TTL_SECONDS=1800
AUTH_VERIFY_EMAIL_TOKEN_TTL_SECONDS=86400
AUTH_RESET_PASSWORD_TOKEN_TTL_SECONDS=3600
AUTH_COOKIE_DOMAIN=http://0.0.0.0:8000
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_FRONTEND_BASE_URL=http://0.0.0.0:8000

# --- Deployment edge (Caddy) ---
# Public domains served by Caddy. The API lives on its own subdomain so it can
# be rate-limited and optionally reached directly by external API clients.
API_DOMAIN=api.learnic.ru
SITE_DOMAIN=learnic.ru
ACME_EMAIL=letsencrypt.cotton427@passmail.net

# Public API rate limit (per source IP). Tune per environment.
# `api` is the loose catch-all; `auth`/`search` are tighter per-zone limits for
# sensitive (/auth/*) and expensive (FTS: /notes/*/search, /users/search, /tags)
# endpoints. A request is counted against every zone it matches (cumulative).
RATE_LIMIT_EVENTS=200
RATE_LIMIT_WINDOW=1m
# Auth endpoints (/auth/*) — defends the public API against scripted brute force.
# (In-UI login goes through a Next Server Action and arrives as the exempt
# frontend host, so this does NOT throttle real users' logins — see Caddyfile.)
AUTH_RATE_LIMIT_EVENTS=20
AUTH_RATE_LIMIT_WINDOW=1m
# Expensive full-text-search endpoints.
SEARCH_RATE_LIMIT_EVENTS=60
SEARCH_RATE_LIMIT_WINDOW=1m
# Space-separated CIDRs exempt from the API rate limit. In a SPLIT (two-host)
# deploy set this to the FRONTEND host's public IP (e.g. 203.0.113.5/32) so its
# SSR / Server-Action traffic isn't throttled by its own aggregate volume. In a
# co-located deploy the frontend reaches the API internally and never hits this
# edge, so the default is fine.
RATE_LIMIT_EXEMPT_IPS=127.0.0.1/32

# Per-user throttle on the FRONTEND domain (used only in co-located mode, where
# this Caddy fronts learnic.ru). Per real visitor IP; static asset paths excluded.
SITE_RATE_LIMIT_EVENTS=300
SITE_RATE_LIMIT_WINDOW=1m
# Tight zone for auth-form submits (POST to login/register/forgot/reset pages) on
# the frontend domain — this is where real-visitor-IP login brute force shows up
# (co-located mode only; in split deploy the frontend's own Caddy enforces it).
SITE_AUTH_RATE_LIMIT_EVENTS=10
SITE_AUTH_RATE_LIMIT_WINDOW=1m

# Caddyfile to mount. Default (unset) = api-only, for a split deploy. For a
# single-host deploy where this Caddy fronts BOTH the frontend and the API,
# set: BACKEND_CADDYFILE=./deploy/caddy/Caddyfile.colocated
# BACKEND_CADDYFILE=./deploy/caddy/Caddyfile.colocated
