<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:16px 0 24px 0;">
  <tr>
    {%- for digit in component.code -%}
    <td style="padding-right:8px;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td align="center" style="width:48px;height:64px;border:2px solid {{ brand_color }};border-radius:8px;font-size:32px;font-weight:700;color:{{ brand_color }};font-family:{{ font_family }};">{{ digit }}</td>
        </tr>
      </table>
    </td>
    {%- endfor -%}
  </tr>
</table>
