<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 24px 0;">
  <tr>
    <td bgcolor="{{ brand_color }}" style="background-color:{{ brand_color }};border-radius:8px;">
      <a href="{{ component.url }}" target="_blank" style="display:inline-block;padding:10px 18px;font-family:{{ font_family }};font-size:14px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:8px;">{{ component.label }}</a>
    </td>
  </tr>
</table>
